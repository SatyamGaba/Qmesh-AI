# Copy to .env.local and fill in. See src/lib/config.ts.
# NEXT_PUBLIC_ vars are exposed to the browser by Next.js.
# .env.local is gitignored (holds a machine-specific LAN address).

# "openai" streams from a real OpenAI-compatible engine; "mock" = canned offline floor.
NEXT_PUBLIC_ENGINE_MODE=mock

# OpenAI-compatible base URL incl. the /v1 suffix, e.g. a laptop llama-server:
#   NEXT_PUBLIC_ENGINE_BASE_URL=http://<laptop-lan-ip>:8082/v1
NEXT_PUBLIC_ENGINE_BASE_URL=

# Model id — must match the engine's /v1/models (e.g. qwen3-4b).
NEXT_PUBLIC_ENGINE_MODEL=

# Bearer token; llama-server needs none, leave empty.
NEXT_PUBLIC_ENGINE_API_KEY=
