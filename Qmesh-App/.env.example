# Copy to .env.local and fill in. See src/lib/config.ts.
# NEXT_PUBLIC_ vars are exposed to the browser by Next.js.
# .env.local is gitignored (holds machine-specific LAN addresses).

# Default mode on first load: "openai" lands on the first available real engine
# below; anything else (or unset) starts on the mock offline floor.
NEXT_PUBLIC_ENGINE_MODE=mock

# Model id — must match the engine's /v1/models (e.g. qwen3-4b). Shared by all
# real-engine modes below.
NEXT_PUBLIC_ENGINE_MODEL=

# Per-mode OpenAI-compatible base URLs, incl. the /v1 suffix. Leave a mode blank
# to have it show as "not set up" (greyed) in the picker.
#   On-device : llama.cpp on the phone            e.g. http://localhost:8082/v1
#   Split     : phone main + laptop RPC worker    e.g. http://localhost:8081/v1
#   Remote    : engine on the laptop              e.g. http://<laptop-lan-ip>:8082/v1
NEXT_PUBLIC_ENGINE_LOCAL_URL=
NEXT_PUBLIC_ENGINE_SPLIT_URL=
NEXT_PUBLIC_ENGINE_REMOTE_URL=

# Bearer token; llama-server needs none, leave empty.
NEXT_PUBLIC_ENGINE_API_KEY=
