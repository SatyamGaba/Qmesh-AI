# Playwright MCP scratch output (screenshots, snapshots, console logs)
/.playwright-mcp/

# Machine-local network map: DHCP leases, MACs, device serial. Never committed.
/LOCAL_NETWORK.md

# Local model weights — GGUFs are large (GBs); never commit them.
# Keep the directory in the tree (via .gitkeep) but ignore its contents.
/.models/*
!/.models/.gitkeep
